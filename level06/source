#include <stdio.h>

int auth(char *login, unsigned int serial)
{
    size_t last;
    unsigned int hash;
    
    last = strcspn(login,"\n");
    login[last] = '\0';
    int len = strnlen(login, 32);
    if (len < 6) 
        return 1;
    else
    {
        if (ptrace(0, 0, 1, 0) == -1) 
        {
            puts(".---------------------------.");
            puts("| !! TAMPERING DETECTED !!  |");
            puts("\'---------------------------\'");
            return 1;
        }
        else 
        {
            hash = ((int)login[3] ^ 0x1337U) + 0x5eeded;
            for (int i = 0; i < len; i++) 
            {
                if (login[i] < ' ') 
                {
                    return 1;
                }
                hash = hash + ((int)login[i] ^ hash) % 0x539;
            }
            if (serial == hash) 
                return 0;
        }
    }
  return 1;
}

