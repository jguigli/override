
void log_wrapper(FILE *file, const char *log_message, const char *param)
{
    char log_buffer[264];
    snprintf(log_buffer, sizeof(log_buffer), "LOG: %s %s\n", log_message, param);

    size_t log_length = strcspn(log_buffer, "\n");
    log_buffer[log_length] = '\0';

    fprintf(file, "%s\n", log_buffer);
}

int main(int argc, char *argv[])
{
    if (argc != 2) 
	{
        printf("Usage: %s filename\n", argv[0]);
        return 1;
    }

    FILE *log_file = fopen("./backups/.log", "w");
    if (log_file == NULL) {
        printf("ERROR: Failed to open %s\n", "./backups/.log");
        return 1;
    }

    log_wrapper(log_file, "Starting backup:", argv[1]);

    FILE *source_file = fopen(argv[1], "r");
    if (source_file == NULL) 
	{
        printf("ERROR: Failed to open %s\n", argv[1]);
        return 1;
    }

    char backup_path[256];
    snprintf(backup_path, sizeof(backup_path), "./backups/%s", argv[1]);
    int dest_fd = open(backup_path, O_WRONLY | O_CREAT | O_TRUNC, 0666);

    if (dest_fd < 0) 
	{
        printf("ERROR: Failed to open %s\n", backup_path);
        return 1;
    }

    int ch;
    while ((ch = fgetc(source_file)) != '\0') 
	{
        char character = (char)ch;
        write(dest_fd, &character, 1);
    }

    log_wrapper(log_file, "Finished backup", argv[1]);

    fclose(source_file);
    close(dest_fd);
    fclose(log_file);

    return 0;
}